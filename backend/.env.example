APP_ENV=development
APP_PORT=8080
APP_NAME=DYF Private Catalog
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=dyf_catalog
DB_SSLMODE=disable
AUTH_TOKEN_EXPIRATION_HOURS=720
OTP_PROVIDER=mock
OTP_EXPIRATION_MINUTES=2
OTP_COOLDOWN_SECONDS=120
MSGWAY_API_KEY=
MSGWAY_TEMPLATE_ID=1
# Production requires OTP_PROVIDER=msgway, real MsgWay credentials and a stable random secret.
MEDIA_SIGNING_KEY=
CORS_ALLOWED_ORIGINS=https://dyfshoes.ir
