{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["frontend/src/*"],
      "@shared/*": ["frontend/src/shared/*"],
      "@admin/*": ["frontend/src/admin/*"],
      "@catalog/*": ["frontend/src/catalog/*"]
    }
  },
  "include": ["vite.config.ts", "frontend/**/*.d.ts", "frontend/**/*.ts", "frontend/**/*.vue"]
}
